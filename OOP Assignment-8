#include <iostream>
#include <string>
using namespace std;

class Person
{
protected:
   string name;
   int age;

public:
   void getPersonData()
   {
      cout<<"Enter Name:";
      cin>>name;
      cout<<"Enter Age:";
      cin>>age;
   }

   void displayPersonData()
   {
      cout<<"\nName:"<<name;
      cout<<"\nAge:"<<age;
   }
};

class Employee:public Person
{
protected:
  int employeeld;
  string department;

public:
   void getEmployeeData()
   {
     getPersonData();

     cout<<"Enter Employee ID:";
     cin>>employeeld;

     cout<<"Enter Department:";
     cin>>department;
   }
   void displayEmployeeData()
   {
      displayPersonData();

      cout<<"\nEmployee ID;"<<employeeld;
      cout<<"\nDepertment:"<<department;
   }
};

class Manager : public Employee
{
private:
  int teamSize;

public:
   void getManagerData() 
   {
      getEmployeeData();

      cout<<"Enter Team Size:";
      cin>>teamSize;
   }
  void displayManagerData()
  {
     displayEmployeeData();

     cout<<"\nTeam Size:"<<teamSize;
  }
};

int main()
{
   Manager m;
   m.getManagerData();
   cout<<""\n\n---Manager Information---";
   m.displayManagerData();

   return 0;
}

