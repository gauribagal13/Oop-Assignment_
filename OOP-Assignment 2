#include <iostream>
#include <string>
using namespace std;

class Student {
    string name;
    int id;
    string branch;

public:
    void inputData() {
        cout << "Enter Student Name: ";
        cin >> name;

        cout << "Enter Roll Number: ";
        cin >> id;

        cout << "Enter Course: ";
        cin >> branch;
    }

    void showData() {
        cout << "\n--- Student Details ---" << endl;
        cout << "Student Name: " << name << endl;
        cout << "Roll Number: " << id << endl;
        cout << "Course: " << branch << endl;
    }
};

int main() {
    Student s1;

    s1.inputData();
    s1.showData();

    return 0;
}

