#include <iostream>
#include <string>
using namespace std;

class Employee
{
    string personName;
    int code;
    string section;
    double income;

public:
    void enterInfo() {
        cout << "Enter Employee Name: ";
        cin >> personName;

        cout << "Enter Employee ID: ";
        cin >> code;

        cout << "Enter Department: ";
        cin >> section;

        cout << "Enter Salary: ";
        cin >> income;
    }

    void printInfo() {
        cout << "\n--- Employee Details ---" << endl;
        cout << "Employee Name: " << personName << endl;
        cout << "Employee ID: " << code << endl;
        cout << "Department: " << section << endl;
        cout << "Salary: " << income << endl;
    }
};

int main() {
    Employee emp;

    emp.enterInfo();
    emp.printInfo();

    return 0;
}

